[TEMPLATE]
# Sample environment variables - copy to .env and fill in values

# ============================================================
# LLM PROVIDERS - full automatic fallback chain
# Only providers with a key set are loaded. If a provider fails,
# rate-limits (429), or times out, the NEXT one automatically takes
# over. Set at least ONE; the more you set, the more resilient PRPilot.
#
#   Gemini (primary) -> Groq -> Cerebras -> OpenRouter -> SwiftRouter
#   -> LLMApi (backup) -> APIFree (backup)
# ============================================================

# 1. Google Gemini (primary) - free keys at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Multiple Gemini keys (comma-separated, rotated on rate limit)
GEMINI_API_KEYS=key1,key2,key3

# 2. Groq (fallback 1) - free key at https://console.groq.com/keys
GROQ_API_KEY=

# 3. Cerebras (fallback 2) - key at https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# 4. OpenRouter (fallback 3+4) - free keys at https://openrouter.ai/keys
# Two keys give you double quota. Models use the :free tier.
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=

# 5. LLMApi.ai (backup) - key at https://llmapi.ai
LLMAPI_API_KEY=

# ============================================================
# GITHUB APP (for live PR reviews)
# ============================================================

# GitHub App credentials (from GitHub Developer Settings)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Supabase (from Supabase Dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Encryption key for storing user API keys (generate a random 32-byte key)
ENCRYPTION_KEY=

# --- Usage limiting (optional security) ---
# Comma-separated GitHub logins that are unlimited (default: mirzasayzz)
PRPILOT_OWNER_LOGINS=mirzasayzz
# Daily review cap per non-owner installation (default 25)
FREE_DAILY_LIMIT=25
# Window (hours) over which the daily cap is counted (default 24)
USAGE_WINDOW_HOURS=24
