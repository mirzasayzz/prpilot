# PRPilot environment variables. Copy to .env and fill in values.
# All values below are placeholders only. Never commit a real .env
# file, a real secret, a real token, or a real private key.
# Vercel functions read os.environ directly; python-dotenv is only
# used by the local test_local.py harness.

# ============================================================
# GitHub App
# From GitHub Developer Settings for the PRPilot GitHub App.
# GITHUB_PRIVATE_KEY is the PEM private key. In Vercel, store it
# with real newlines replaced as the webhook code expects, or as
# a multiline secret if your provider supports it.
# ============================================================
GITHUB_APP_ID=your-github-app-id
GITHUB_PRIVATE_KEY=your-github-app-private-key-pem
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# ============================================================
# Supabase
# From the Supabase project dashboard.
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key

# ============================================================
# Encryption
# Used by db/client.py (Fernet) to encrypt stored user API keys.
# Generate a Fernet key locally; do not reuse a placeholder here.
# ============================================================
ENCRYPTION_KEY=your-fernet-encryption-key

# ============================================================
# LLM providers
# Only providers with a key set are loaded, in this order:
# Gemini, then Groq, then Cerebras, then OpenRouter, then LLMApi.
# If a provider fails, is rate limited, or times out, the next
# available provider is tried. Set at least one provider key.
# Note: older docs mention SwiftRouter and APIFree, but
# agents/llm_client.py as read does not load them, so no
# variables are listed for them here until a provider is added.
# ============================================================
# Google Gemini (primary). Single key, or several comma-separated
# keys that are rotated on rate limit.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEYS=your-gemini-key-1,your-gemini-key-2

# Groq (OpenAI-compatible fallback)
GROQ_API_KEY=your-groq-api-key

# Cerebras (OpenAI-compatible fallback)
CEREBRAS_API_KEY=your-cerebras-api-key

# OpenRouter (OpenAI-compatible fallback, two keys supported)
OPENROUTER_API_KEY_1=your-openrouter-api-key-1
OPENROUTER_API_KEY_2=your-openrouter-api-key-2

# LLMApi.ai (backup provider)
LLMAPI_API_KEY=your-llmapi-api-key

# ============================================================
# Config token and cron
# CONFIG_TOKEN_SECRET and CRON_SECRET are required by
# api/env_check.py in this draft. Their consumers live in modules
# owned by other tracks; confirm those consumers before treating
# a missing value as a production blocker. See NOTES.md.
# ============================================================
CONFIG_TOKEN_SECRET=your-config-token-secret
CRON_SECRET=your-cron-secret

# ============================================================
# Owner logins and daily limit
# PRPILOT_OWNER_LOGINS is a comma-separated list of GitHub
# logins that bypass the daily review cap. Every other
# installation is capped at FREE_DAILY_LIMIT reviews in
# USAGE_WINDOW_HOURS hours, counted from Supabase review records.
# ============================================================
PRPILOT_OWNER_LOGINS=mirzasayzz
FREE_DAILY_LIMIT=25
USAGE_WINDOW_HOURS=24

# ============================================================
# Optional, local only
# DEBUG enables extra debug printing in agents/base.py.
# Do not enable DEBUG in production.
# ============================================================
DEBUG=false
